{
  "name": "bytehive-mcp",
  "version": "0.1.0",
  "description": "MCP server for the ByteHive kanban board (.bytehive/board.json)",
  "license": "MIT",
  "author": "tdat-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tdat-dev/maestro.git",
    "directory": "mcp"
  },
  "type": "module",
  "bin": {
    "bytehive-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
