{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bytehive-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The deployed relay. A local run (`wrangler dev`) takes APP_ORIGIN from .dev.vars.
  "routes": [{ "pattern": "relay.zoldify.com", "custom_domain": true }],
  "vars": { "APP_ORIGIN": "https://remote.zoldify.com", "VAPID_SUBJECT": "mailto:tvmaroka1@gmail.com" }
}
